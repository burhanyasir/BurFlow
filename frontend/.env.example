# ─── Frontend environment (copy to .env.development / .env.production) ────

# Widget bootstrapping for the landing page demo (tenant slug)
VITE_WIDGET_TENANT_ID=burflow-saas

# ─── Paddle Sandbox checkout ──────────────────────────────────────────────
# The public client-side token (test_... for sandbox) from your Paddle
# dashboard → Developer tools → Authentication. Initialize without it fails
# loudly and the billing page falls back to static pricing.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
