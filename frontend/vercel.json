{
  "rewrites": [
    {
      "source": "/api/public/preview-scan",
      "destination": "/api/public/preview-scan"
    },
    {
      "source": "/api/(?!(public/preview-scan)).*",
      "destination": "https://burflow.onrender.com/api/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
