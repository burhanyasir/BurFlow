# ─── Conversation Engine — Production Environment Variables ────
# Copy this file to .env and fill in your values.
# ⚠ = Required   ✏️ = Change for production

# ── General ────────────────────────────────────────────────────
NODE_ENV=production                                    # production | development | staging
LOG_LEVEL=info                                          # trace | debug | info | warn | error
APP_URL=https://app.yourdomain.com                      # ⚠ Public URL of the admin portal (used in emails, redirects, widget)
APP_VERSION=1.0.0                                       # Version tag for health check responses

# ── Pipeline Orchestrator ──────────────────────────────────────
# PORT=3456                                             # Internal port (Docker default, do not change)
DATA_DIR=./data                                         # ⚠ Persistent volume mount point
LLM_API_KEY=pk-...                                      # ⚠ LLM provider API key
INTERNAL_SYNC_KEY=generate-a-64-char-random-secret      # ⚠ Shared secret for service-to-service auth
JWT_SECRET=generate-another-64-char-random-secret       # ⚠ Used to sign and verify JWT tokens (required by both services)

# ── SaaS API ───────────────────────────────────────────────────
# SAAS_PORT=3457                                        # Internal port (Docker default, do not change)
CORS_ORIGIN=https://app.yourdomain.com                  # ⚠ Comma-separated allowed CORS origins (set to false to block all)
DATABASE_PATH=./data/saas.db                            # SQLite database path (within Docker volume) — alias DB_PATH is also accepted
# ── Postgres (Neon) ────────────────────────────────────────────
# Database selection precedence (exactly one backend is ever active):
#   DATABASE_URL set  → PostgreSQL (production/Neon). Run `npm run db:migrate`
#                      first — the app never auto-migrates on boot, and it
#                      FAILS CLEARLY (no SQLite fallback) if Postgres is
#                      unreachable or the schema is missing.
#   otherwise         → SQLite at DATABASE_PATH / DB_PATH (local/test).
# For Neon, append ?sslmode=require to the connection string.
# NEVER commit the real connection string — keep it in .env (gitignored).
# `npm run db:migrate` and `npm run db:migrate:status` read engine/.env
# automatically (plain KEY=VALUE lines); the app itself expects the variable
# exported in its environment. Values are never printed by the CLIs.
DATABASE_URL=
# Dedicated SQLite file for the knowledge-pipeline stores (vector store,
# knowledge store, queue). Only used when the primary db is PostgreSQL; the
# pipeline stores are SQLite-only and must not share the Postgres schema.
KNOWLEDGE_DB_PATH=./data/knowledge-saas.db
WIDGET_SECRET=generate-a-widget-secret                  # ⚠ Used to sign widget tokens (HMAC-SHA256)
OPENAI_API_KEY=sk-...                                   # ⚠ Required in production — OpenAI API key for embeddings
EMBEDDING_DIMENSION=1536                                # Vector embedding dimension (1536 for OpenAI text-embedding-3-small)

# ── Conversation Engine LLM Providers ─────────────────────────
# The chat brain can use Anthropic, OpenRouter, or Grok/xAI. Auto-detected
# from whichever keys are set; LLM_PROVIDER pins the preferred one.
#   LLM_PROVIDER=anthropic | openrouter | grok   (unset = auto-detect)
LLM_PROVIDER=                                           # Optional pin: 'anthropic' | 'openrouter' | 'grok'
ANTHROPIC_API_KEY=sk-ant-...                            # Anthropic API key (claude-3-haiku)
OPENROUTER_API_KEY=sk-or-...                            # OpenRouter API key
OPENROUTER_MODEL=openai/gpt-4o-mini                     # OpenRouter model override (e.g. anthropic/claude-3-haiku)
XAI_API_KEY=xai-...                                     # Grok/xAI API key (alias GROK_API_KEY also accepted)
GROK_API_KEY=                                           # Legacy alias for XAI_API_KEY
GROK_MODEL=grok-2-latest                                # Grok model override
PIPELINE_URL=http://pipeline-orchestrator:3456          # ⚠ Pipeline service URL (internal Docker network)
PADDLE_API_KEY=                                        # Paddle API key for billing (required for checkout)
PADDLE_WEBHOOK_SECRET=                                  # Paddle webhook signing secret (required for webhook processing)
PADDLE_ENVIRONMENT=sandbox                              # Paddle environment: sandbox | production

# ── Paddle Sandbox catalog ─────────────────────────────────────
# Populated by engine/scripts/provision-paddle-catalog.js — run it with your
# PADDLE_API_KEY and paste the printed IDs here, then restart the backend.
PADDLE_PRODUCT_STARTER=                                 # Paddle product ID for Starter
PADDLE_PRODUCT_PRO=                                     # Paddle product ID for Pro
PADDLE_PRODUCT_ADVANCED=                                # Paddle product ID for Advanced
PADDLE_PRICE_STARTER_MONTHLY=                           # Starter monthly (USD $10.00, 7-day trial)
PADDLE_PRICE_STARTER_YEARLY=                            # Starter yearly (USD $100.00)
PADDLE_PRICE_PRO_MONTHLY=                               # Pro monthly (USD $40.00, 7-day trial)
PADDLE_PRICE_PRO_YEARLY=                                # Pro yearly (USD $400.00)
PADDLE_PRICE_ADVANCED_MONTHLY=                          # Advanced monthly (USD $120.00, 7-day trial)
PADDLE_PRICE_ADVANCED_YEARLY=                           # Advanced yearly (USD $1200.00)

SENDGRID_FROM_EMAIL=noreply@yourdomain.com              # Legacy (ignored — the Resend provider uses EMAIL_FROM below)

# ── WhatsApp (Meta) webhooks ──────────────────────────────────
WHATSAPP_VERIFY_TOKEN=                                  # Verify token for the GET hub.challenge handshake
WHATSAPP_APP_SECRET=                                    # ⚠ Meta App Secret — required to verify X-Hub-Signature-256 on inbound webhooks. POSTs are rejected (401) without a valid signature.
WHATSAPP_TENANT_ID=                                     # Tenant that owns the WhatsApp phone number
WHATSAPP_PHONE_NUMBER_ID=                               # Meta phone number ID for outbound replies
WHATSAPP_TOKEN=                                         # Meta access token for outbound replies
RATE_LIMIT_WINDOW_MS=60000                              # Rate limit window in milliseconds (default 1 min)
RATE_LIMIT_MAX=100                                      # Max requests per window per IP

# ── Database ───────────────────────────────────────────────────
DB_BACKUP_DIR=./backups                                 # Backup directory
DB_BACKUP_RETENTION_DAYS=30                             # How many days to keep backups

# ── Email (Resend — verification, password reset) ───────────────
# ⚠ RESEND_API_KEY is required in production. SENDGRID_API_KEY is accepted as
# a legacy fallback (its value is used as the Resend API key). Leave both empty
# in development to log emails to the console.
RESEND_API_KEY=re_....                                   # ⚠ Resend API key (required in production)
EMAIL_FROM=BurFlow <onboarding@resend.dev>               # Sender address for all transactional emails
SENDGRID_API_KEY=SG....                                  # Legacy fallback only — prefer RESEND_API_KEY
EMAIL_PROVIDER=RESEND                                    # Options: RESEND | CONSOLE (informational only)
SALES_NOTIFY_EMAIL=sales@yourcompany.com                 # Optional: email address notified for contact/demo/scan form leads

# ── Monitoring ────────────────────────────────────────────────
# Leave empty to disable external monitoring
DATADOG_API_KEY=
SENTRY_DSN=

# ── Deployment ─────────────────────────────────────────────────
DOCKER_TAG=latest                                        # Image tag for deployments
