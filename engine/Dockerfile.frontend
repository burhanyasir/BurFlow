# ─── Canonical Dashboard Frontend (frontend/) ─────────────────────
# Builds the canonical React dashboard at the repository root (frontend/)
# and serves it via nginx with an /api reverse proxy to saas-api:3000.
#
# IMPORTANT: the build context must be the REPOSITORY ROOT (not engine/),
# because the canonical frontend/ package lives outside engine/:
#
#   docker build -f engine/Dockerfile.frontend -t burflow/frontend .
#   # or in docker-compose: build: { context: .., dockerfile: engine/Dockerfile.frontend }

FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first for optimal layer caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# VITE_API_URL is a build-time variable inlined by Vite. When unset, the
# dashboard calls the same origin (/api) and nginx proxies to saas-api.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.25-alpine
RUN apk add --no-cache tini
COPY --from=build /app/dist /usr/share/nginx/html
COPY engine/nginx/frontend.conf /etc/nginx/conf.d/default.conf
RUN chown -R nginx:nginx /usr/share/nginx/html && chmod -R 755 /usr/share/nginx/html
USER nginx
EXPOSE 80
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["nginx", "-g", "daemon off;"]
